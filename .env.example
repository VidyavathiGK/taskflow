SECRET_KEY=django-insecure-taskflow-demo-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL by default)
# Django 5.x uses psycopg (psycopg3) by default with engine django.db.backends.postgresql
DB_ENGINE=django.db.backends.postgresql
DB_NAME=taskflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Set to True to use SQLite instead of PostgreSQL for instant zero-setup local dev
USE_SQLITE=False

# Channel Layer Configuration (Redis by default for real-time WebSockets sync)
REDIS_URL=redis://127.0.0.1:6379/1

# Set to True to use Django Channels InMemoryChannelLayer for testing without Redis
USE_IN_MEMORY_CHANNEL_LAYER=False
